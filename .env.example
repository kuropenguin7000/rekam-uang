# Copy to .env and fill in. The app runs with all real integrations OFF (mock
# parser + demo login + mock Midtrans) so you can start with zero credentials.

# Database — PostgreSQL (run `docker compose up -d` first).
DATABASE_URL="postgresql://spendwise:spendwise@localhost:5433/spendwise?schema=public"

# Auth
AUTH_SECRET="change-me-to-a-long-random-string"
MASTER_EMAIL="ctlvechocolatoz@gmail.com"

# Google OAuth (optional). Set both to enable real Google sign-in; otherwise the
# demo sign-in is used. Redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APP_URL="http://localhost:3000"

# Anthropic Claude (optional). Set to use Claude Haiku for parsing/analysis;
# otherwise a local mock parser/insights engine is used.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# Midtrans (mocked). Keep MIDTRANS_MOCK=true for the simulated payment flow.
MIDTRANS_MOCK="true"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
