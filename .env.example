# Copy to .env and fill in. AI and Midtrans have working fallbacks/mocks, but
# signing in requires Google OAuth (demo login has been removed).

# Database — PostgreSQL (run `docker compose up -d` first).
DATABASE_URL="postgresql://spendwise:spendwise@localhost:5433/spendwise?schema=public"

# Auth
AUTH_SECRET="change-me-to-a-long-random-string"
MASTER_EMAIL=""   # your email → unlocks all features (master account)

# Google OAuth — required to sign in. Register the redirect URI
# ${APP_URL}/api/auth/google/callback in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APP_URL="http://localhost:3000"

# Google Gemini (optional). Without a key, a local regex parser/insights engine
# is used. Provide extra keys (_2/_3 or comma-separated GEMINI_API_KEYS) for
# automatic failover on quota/rate limits.
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_MODEL="gemini-2.5-flash"

# Midtrans (mocked). Keep MIDTRANS_MOCK=true for the simulated payment flow.
MIDTRANS_MOCK="true"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
