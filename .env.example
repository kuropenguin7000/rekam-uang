# Copy to .env and fill in from your Firebase project — that's all the app
# needs (no server, no service account: the browser talks to Firebase directly
# and firestore.rules enforce per-user access).

# Firebase web app config (Console → Project settings → General → Your apps).
# These are public identifiers (inlined into the client bundle), not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Optional: set to 1 to run against the local Auth/Firestore emulators
# (ports in firebase.json) instead of a real project.
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS="1"
