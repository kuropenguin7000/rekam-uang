// Prisma schema. Uses SQLite for zero-config local dev; switch `provider` to
// "postgresql" and update DATABASE_URL to move to PostgreSQL (per the PRD)
// without changing any application code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  // "master" sees every feature; "user" is a normal account.
  role      String   @default("user")
  // "free" or "pro". Master accounts are treated as pro+ everywhere.
  plan      String   @default("free")
  createdAt DateTime @default(now())

  transactions  Transaction[]
  subscriptions Subscription[]
  usages        Usage[]
  budget        Int      @default(5000000)
  // Daily budget threshold (chart red line). 0 = auto (budget / 30).
  dailyBudget   Int      @default(0)
  // Cached AI analysis: signature of the data it was generated from + the
  // serialized insights. Lets repeated "Analyze" clicks reuse the result
  // instead of re-calling Claude (cost control).
  analysisSig   String?
  analysisJson  String?
  // When the current paid (Pro) period ends. null = no active paid period
  // (free users) or no expiry (master). Set by the billing webhook.
  planExpiresAt DateTime?
  // Optional per-category monthly spending caps as a JSON map, e.g.
  // {"food":1000000,"transport":500000}. null/absent categories have no cap.
  categoryBudgets String?
  // User category customisation as JSON: custom categories + built-in
  // rename/hide overrides. null = defaults. See lib/categories CategoriesConfig.
  categoriesConfig String?
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  category  String
  // "expense" (default) or "income". Income is excluded from the expense
  // category breakdown / budget usage and feeds the cash-flow (net) total.
  type      String   @default("expense")
  merchant  String   @default("")
  note      String   @default("")
  date      String // ISO yyyy-mm-dd
  createdAt DateTime @default(now())

  @@index([userId])
}

// Midtrans order/subscription record (mocked for now).
model Subscription {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           String
  status         String   @default("pending") // pending | active | failed | expired
  // Billing cycle for this order; drives the period length on settlement.
  cycle          String   @default("monthly") // monthly | yearly
  orderId        String   @unique
  grossAmount    Int
  midtransToken  String?
  paymentType    String?
  // End of the paid period this order grants, set when payment settles.
  currentPeriodEnd DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// Per-user, per-day counter used to enforce free-plan AI trial limits.
model Usage {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     String // ISO yyyy-mm-dd
  feature String // "parse" | "analyze"
  count   Int    @default(0)
  // last generation time — used for the per-request cooldown / rate limit
  updatedAt DateTime? @updatedAt

  @@unique([userId, day, feature])
  @@index([userId])
}
